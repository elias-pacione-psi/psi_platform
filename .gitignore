# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planificación / exports de IA (no es código del proyecto)
Cuentas asociadas Plataforma Elias.txt

# salida de generar-ilustraciones.mjs — la copia publicada vive en el bucket de R2,
# el script es la fuente (ver el encabezado de generar-ilustraciones.mjs)
/.ilustraciones/
